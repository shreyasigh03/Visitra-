# Copy this file to backend/.env and fill in real values.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/visitra
PORT=5001

# Gmail address + 16-character Gmail "App Password" used to send OTP/approval emails
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Admin dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string (keep it secret)
JWT_SECRET=replace-with-a-long-random-string

# Where the Python face service runs
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional: DNS used to resolve the Atlas address. "system" = use your computer's DNS.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Old-data clean-up
# Months after the visit before the face photo and face data are deleted
FACE_RETENTION_MONTHS=3
# Months after the visit before a record moves to Excel and leaves the database
RECORD_RETENTION_MONTHS=12
# Folder for the Excel files, such as a Google Drive folder. Empty = backend/archive
ARCHIVE_DIR=
# true = clean up every day by itself. Anything else = only from the Old Records page
AUTO_CLEANUP=false

# Teacher dashboard
# Address of the website, used in emails to teachers
WEB_URL=http://localhost:5173
# Phone notifications. Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Gate
# Hours inside before the overstay alert
OVERSTAY_HOURS=4
# true = mark visitors left open since an earlier day as gone, by itself
AUTO_CLOSE_EXITS=false

# The owners of VISITRA, who manage all organizations. Empty = this login is off
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
